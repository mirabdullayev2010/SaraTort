                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bg-option-box bg-preset-3 d-flex align-items-center justify-content-center" onclick="setBgPreset('bg-preset-3')">
                                <span class="fw-bold text-white small"><i class="fa-solid fa-gem me-1"></i> Neon Velvet</span>
                            </div>
                        </div>
                        <div class="col-6">
                            <div class="bg-option-box bg-preset-4 d-flex align-items-center justify-content-center" onclick="setBgPreset('bg-preset-4')">
