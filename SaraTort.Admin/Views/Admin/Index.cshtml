    <!-- YANGI MAHSULOT QO'SHISH MODALI -->
    <div class="modal fade" id="addCakeModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-content-ios p-2">
                <div class="modal-header border-0 pb-0 pt-3 px-4">
                    <h5 class="modal-title fw-extrabold text-white">
                        <i class="fa-solid fa-plus-circle text-pink me-2"></i>Yangi Mahsulot Qo'shish
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <form asp-action="CreateCake" asp-controller="Admin" method="post" enctype="multipart/form-data">
                    <div class="modal-body d-flex flex-column gap-3 p-4">
                        <div>
                            <label class="form-label text-secondary small fw-bold mb-1">Mahsulot Nomi</label>
                            <input type="text" name="Title" class="form-control ios-input" placeholder="Masalan: Shokoladli Tort" required>
                        </div>
                        <div>
                            <label class="form-label text-secondary small fw-bold mb-1">Narxi (UZS)</label>
                            <input type="number" name="Price" class="form-control ios-input" placeholder="Masalan: 120000" required>
                        </div>
                        <div>
                            <label class="form-label text-secondary small fw-bold mb-1">Tavsif</label>
                            <textarea name="Description" class="form-control ios-input" rows="3" placeholder="Mahsulot haqida qisqacha ma'lumot..."></textarea>
                        </div>
                        <div>
                            <label class="form-label text-secondary small fw-bold mb-1">Mahsulot Rasmi</label>
                            <input type="file" name="Image" class="form-control ios-input" accept="image/*" required>
                        </div>
                    </div>
                    <div class="modal-footer border-0 pt-0 px-4 pb-3">
                        <button type="button" class="btn btn-outline-light rounded-3 px-4 py-2" data-bs-dismiss="modal">Bekor qilish</button>
                        <button type="submit" class="btn btn-ios-primary px-4 py-2">Saqlash</button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <!-- TAHRIRLASH VA O'CHIRISH MODALLARI (DYNAMIKS) -->
    @if (Model.TortlarRoyxati != null && Model.TortlarRoyxati.Any())
    {
        @foreach (var cake in Model.TortlarRoyxati)
        {
            <!-- Edit Modal -->
            <div class="modal fade" id="editCakeModal-@cake.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content modal-content-ios p-2">
                        <div class="modal-header border-0 pb-0 pt-3 px-4">
                            <h5 class="modal-title fw-bold text-white">
                                <i class="fa-solid fa-pen-to-square text-warning me-2"></i>Mahsulotni Tahrirlash
                            </h5>
                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                        </div>
                        <form asp-action="EditCake" asp-controller="Admin" method="post" enctype="multipart/form-data">
                            <input type="hidden" name="Id" value="@cake.Id" />
                            <div class="modal-body d-flex flex-column gap-3 p-4 text-start">
                                <div>
                                    <label class="form-label text-secondary small fw-bold mb-1">Nomi</label>
                                    <input type="text" name="Title" class="form-control ios-input" value="@cake.Title" required>
                                </div>
                                <div>
                                    <label class="form-label text-secondary small fw-bold mb-1">Narxi (UZS)</label>
                                    <input type="number" name="Price" class="form-control ios-input" value="@cake.Price" required>
                                </div>
                                <div>
                                    <label class="form-label text-secondary small fw-bold mb-1">Tavsif</label>
                                    <textarea name="Description" class="form-control ios-input" rows="3">@cake.Description</textarea>
                                </div>
                                <div>
                                    <label class="form-label text-secondary small fw-bold mb-1">Yangi Rasm (Tanlanmasa o'zgarmaydi)</label>
                                    <input type="file" name="Image" class="form-control ios-input" accept="image/*">
                                </div>
                            </div>
                            <div class="modal-footer border-0 pt-0 px-4 pb-3">
                                <button type="button" class="btn btn-outline-light rounded-3 px-4 py-2" data-bs-dismiss="modal">Bekor qilish</button>
                                <button type="submit" class="btn btn-ios-primary px-4 py-2">Saqlash</button>
                            </div>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Delete Confirmation Modal -->
            <div class="modal fade" id="deleteCakeModal-@cake.Id" tabindex="-1" aria-hidden="true">
                <div class="modal-dialog modal-dialog-centered">
                    <div class="modal-content modal-content-ios text-center p-4">
                        <div class="modal-body">
                            <div class="p-3 rounded-circle bg-danger bg-opacity-10 text-danger d-inline-flex mb-3">
                                <i class="fa-solid fa-triangle-exclamation fs-1"></i>
                            </div>
                            <h5 class="fw-bold text-white mb-2">O'chirishni tasdiqlaysizmi?</h5>
                            <p class="text-secondary small mb-4">Siz rostdan ham "<strong>@cake.Title</strong>" mahsulotini ma'lumotlar bazasidan o'chirmoqchimisiz?</p>
                            <form asp-action="DeleteCake" asp-controller="Admin" method="post">
                                <input type="hidden" name="id" value="@cake.Id" />
                                <div class="d-flex justify-content-center gap-3">
                                    <button type="button" class="btn btn-outline-light rounded-3 px-4 py-2" data-bs-dismiss="modal">Bekor qilish</button>
                                    <button type="submit" class="btn btn-danger rounded-3 px-4 py-2 fw-bold">Ha, o'chirilsin</button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    }

