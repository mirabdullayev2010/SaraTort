    <!-- Bootstrap 5 JS Bundle -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>

    <!-- Background Switcher, Bar Sub-menu & Table Search Scripts -->
    <script>
            // Toggle Bar Submenu
            function toggleBarMenu() {
                var subMenu = document.getElementById("barSubMenu");
                var arrow = document.getElementById("barArrow");

                if (subMenu.style.display === "none" || subMenu.style.display === "") {
                    subMenu.style.display = "block";
                    arrow.classList.add("rotate-180");
                } else {
                    subMenu.style.display = "none";
                    arrow.classList.remove("rotate-180");
                }
            }

            // On Page Load: Restore Saved Background from LocalStorage
            document.addEventListener("DOMContentLoaded", function() {
                var savedBgType = localStorage.getItem("saratort_bg_type");
                var savedBgValue = localStorage.getItem("saratort_bg_value");

                if (savedBgType === "preset" && savedBgValue) {
                    document.body.className = savedBgValue;
                } else if (savedBgType === "custom" && savedBgValue) {
                    document.body.className = "";
                    document.body.style.backgroundImage = "url('" + savedBgValue + "')";
                }
            });

            // Set Preset Theme
            function setBgPreset(presetClass) {
                document.body.style.backgroundImage = "";
                document.body.className = presetClass;

                localStorage.setItem("saratort_bg_type", "preset");
                localStorage.setItem("saratort_bg_value", presetClass);
            }

            // Set Custom Image URL
            function setCustomBg() {
                var urlInput = document.getElementById("customBgUrl").value.trim();
                if (urlInput) {
                    document.body.className = "";
                    document.body.style.backgroundImage = "url('" + urlInput + "')";

                    localStorage.setItem("saratort_bg_type", "custom");
                    localStorage.setItem("saratort_bg_value", urlInput);
                }
            }

            // Search Table Script
            function searchTable() {
                var input = document.getElementById("searchInput");
                var filter = input.value.toLowerCase();
                var rows = document.querySelectorAll("#productsTable tbody tr");

                rows.forEach(row => {
                    var title = row.querySelector(".product-name");
                    if (title) {
                        var text = title.textContent || title.innerText;
                        row.style.display = text.toLowerCase().indexOf(filter) > -1 ? "" : "none";
                    }
                });
            }
    </script>
</body>
</html>