@model SaraTort.Admin.Models.DashboardViewModel

@{
    Layout = null;
    ViewData["Title"] = "Boshqaruv Paneli - Sara Tort";
}

<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Google Fonts (Plus Jakarta Sans) -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            :root {
                --bg-dark: #080711;
                --sidebar-bg: rgba(13, 12, 29, 0.75);
                --card-bg: rgba(20, 20, 42, 0.6);
                --card-border: rgba(255, 255, 255, 0.08);
                --accent-pink: #ff2a75;
                --accent-pink-glow: rgba(255, 42, 117, 0.4);
                --accent-purple: #8a2be2;
                --accent-gold: #ffb703;
                --text-primary: #ffffff;
                --text-secondary: #94a3b8;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: var(--bg-dark);
                color: var(--text-primary);
                min-height: 100vh;
                overflow-x: hidden;
                transition: background 0.5s ease;
                background-size: cover;
                background-position: center;
                background-attachment: fixed;
            }

                /* Default Background Presets */
                body.bg-preset-1 {
                    background-image: radial-gradient(circle at 10% 20%, rgba(255, 42, 117, 0.12) 0%, transparent 40%), radial-gradient(circle at 90% 80%, rgba(138, 43, 226, 0.12) 0%, transparent 40%), linear-gradient(135deg, #080711 0%, #0f172a 100%);
                }

                body.bg-preset-2 {
                    background-image: radial-gradient(circle at 50% 0%, rgba(56, 189, 248, 0.15) 0%, transparent 50%), linear-gradient(135deg, #020617 0%, #0d1527 100%);
                }

                body.bg-preset-3 {
                    background-image: radial-gradient(circle at 80% 20%, rgba(236, 72, 153, 0.15) 0%, transparent 45%), linear-gradient(135deg, #18051b 0%, #080711 100%);
                }

                body.bg-preset-4 {
                    background-image: radial-gradient(circle at 20% 80%, rgba(16, 185, 129, 0.12) 0%, transparent 40%), linear-gradient(135deg, #061a14 0%, #020617 100%);
                }

            /* Custom Scrollbar */
            ::-webkit-scrollbar {
                width: 6px;
                height: 6px;
            }

            ::-webkit-scrollbar-track {
                background: rgba(0, 0, 0, 0.2);
            }

            ::-webkit-scrollbar-thumb {
                background: rgba(255, 255, 255, 0.15);
                border-radius: 10px;
            }

                ::-webkit-scrollbar-thumb:hover {
                    background: var(--accent-pink);
                }

            /* Layout Structure */
            .app-container {
                display: flex;
                width: 100vw;
                min-height: 100vh;
                position: relative;
            }

            /* Sidebar Styling */
            .sidebar {
                width: 280px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background: var(--sidebar-bg);
                backdrop-filter: blur(30px) saturate(180%);
                -webkit-backdrop-filter: blur(30px) saturate(180%);
                border-right: 1px solid var(--card-border);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 1.75rem 1.25rem;
                z-index: 1000;
            }

            .brand-header {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 0.5rem 0.25rem;
                margin-bottom: 2rem;
            }

            .brand-icon-box {
                width: 46px;
                height: 46px;
                background: linear-gradient(135deg, var(--accent-pink), var(--accent-purple));
                border-radius: 14px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 1.3rem;
                box-shadow: 0 8px 20px var(--accent-pink-glow);
            }

            .brand-title {
                font-size: 1.1rem;
                font-weight: 800;
                letter-spacing: 0.5px;
                color: white;
                line-height: 1.2;
            }

            .brand-subtitle {
                font-size: 0.65rem;
                font-weight: 700;
                color: var(--accent-pink);
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            .menu-section-title {
                font-size: 0.65rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 1.5px;
                color: var(--text-secondary);
                margin: 1.5rem 0 0.75rem 0.75rem;
            }

            .nav-menu {
                display: flex;
                flex-direction: column;
                gap: 6px;
            }

            .nav-item-link {
                display: flex;
                align-items: center;
                gap: 14px;
                padding: 0.85rem 1rem;
                color: var(--text-secondary);
                text-decoration: none;
                font-weight: 600;
                font-size: 0.9rem;
                border-radius: 14px;
                transition: all 0.25s ease;
                position: relative;
            }

                .nav-item-link:hover {
                    color: white;
                    background: rgba(255, 255, 255, 0.05);
                    transform: translateX(3px);
                }

                .nav-item-link.active {
                    color: white;
                    background: linear-gradient(90deg, rgba(255, 42, 117, 0.18), rgba(138, 43, 226, 0.08));
                    border: 1px solid rgba(255, 42, 117, 0.3);
                    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
                }

                    .nav-item-link.active::before {
                        content: '';
                        position: absolute;
                        left: 0;
                        top: 20%;
                        height: 60%;
                        width: 4px;
                        background: var(--accent-pink);
                        border-radius: 0 4px 4px 0;
                        box-shadow: 0 0 10px var(--accent-pink);
                    }

            /* Sub Menu Transitions */
            .transition-icon {
                transition: transform 0.3s ease;
            }

                .transition-icon.rotate-180 {
                    transform: rotate(180deg);
                }

            .sub-menu .nav-item-link {
                color: rgba(255, 255, 255, 0.65);
            }

                .sub-menu .nav-item-link:hover {
                    color: #ffffff;
                    background: rgba(255, 255, 255, 0.08);
                    transform: translateX(2px);
                }

            /* Branch Card Box */
            .branch-info-card {
                background: rgba(255, 255, 255, 0.03);
                border: 1px solid var(--card-border);
                border-radius: 14px;
                padding: 10px 12px;
                margin-bottom: 8px;
                transition: all 0.2s ease;
            }

                .branch-info-card:hover {
                    border-color: rgba(255, 255, 255, 0.15);
                    background: rgba(255, 255, 255, 0.05);
                }

            /* User Profile Footer */
            .user-profile-box {
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid var(--card-border);
                border-radius: 16px;
                padding: 12px;
                backdrop-filter: blur(10px);
            }

            /* Main Wrapper */
            .main-wrapper {
                margin-left: 280px;
                width: calc(100% - 280px);
                padding: 2.2rem 2.5rem;
                min-height: 100vh;
            }

            /* Header UI */
            .header-title {
                font-size: 1.75rem;
                font-weight: 800;
                letter-spacing: -0.5px;
            }

            .cyber-search {
                background: rgba(255, 255, 255, 0.04);
                backdrop-filter: blur(20px);
                border: 1px solid var(--card-border);
                border-radius: 14px;
                padding: 10px 18px;
                display: flex;
                align-items: center;
                gap: 12px;
                color: var(--text-secondary);
                transition: all 0.3s ease;
                width: 240px;
            }

                .cyber-search:focus-within {
                    border-color: rgba(255, 42, 117, 0.5);
                    box-shadow: 0 0 15px rgba(255, 42, 117, 0.15);
                    background: rgba(255, 255, 255, 0.07);
                    width: 280px;
                }

                .cyber-search input {
                    background: transparent;
                    border: none;
                    outline: none;
                    color: white;
                    font-size: 0.9rem;
                    width: 100%;
                }

            /* Glassmorphism Cards */
            .glass-card {
                background: var(--card-bg);
                backdrop-filter: blur(20px) saturate(160%);
                -webkit-backdrop-filter: blur(20px) saturate(160%);
                border: 1px solid var(--card-border);
                border-radius: 24px;
                padding: 1.75rem;
                box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
                position: relative;
                overflow: hidden;
            }

                .glass-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 1px;
                    background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.15), transparent);
                }

            /* Buttons */
            .btn-ios-primary {
                background: linear-gradient(135deg, var(--accent-pink), var(--accent-purple));
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: white !important;
                font-weight: 700;
                font-size: 0.9rem;
                border-radius: 14px;
                padding: 12px 22px;
                box-shadow: 0 8px 25px var(--accent-pink-glow);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                white-space: nowrap !important;
                display: inline-flex;
                align-items: center;
                justify-content: center;
                cursor: pointer;
            }

                .btn-ios-primary:hover {
                    transform: translateY(-2px) scale(1.02);
                    box-shadow: 0 12px 30px rgba(255, 42, 117, 0.6);
                }

            .btn-ios-secondary {
                background: rgba(255, 255, 255, 0.06);
                border: 1px solid var(--card-border);
                color: white;
                font-weight: 600;
                font-size: 0.9rem;
                border-radius: 14px;
                padding: 12px 18px;
                transition: all 0.25s ease;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .btn-ios-secondary:hover {
                    background: rgba(255, 255, 255, 0.12);
                    color: white;
                    border-color: rgba(255, 255, 255, 0.2);
                }

            /* Table Styling */
            .table-cyber-container {
                border-radius: 18px;
                overflow: hidden;
            }

            .table-cyber {
                width: 100%;
                border-collapse: separate;
                border-spacing: 0 10px;
                margin-top: -10px;
            }

                .table-cyber th {
                    color: var(--text-secondary);
                    font-size: 0.72rem;
                    font-weight: 800;
                    text-transform: uppercase;
                    letter-spacing: 1.2px;
                    border: none;
                    padding: 14px 18px;
                    background: transparent !important;
                }

                .table-cyber td {
                    background: rgba(255, 255, 255, 0.025);
                    backdrop-filter: blur(10px);
                    padding: 16px 18px;
                    vertical-align: middle;
                    border-top: 1px solid var(--card-border);
                    border-bottom: 1px solid var(--card-border);
                    font-size: 0.92rem;
                    color: white;
                    transition: all 0.2s ease;
                }

                .table-cyber tr:hover td {
                    background: rgba(255, 255, 255, 0.05);
                    border-color: rgba(255, 255, 255, 0.15);
                }

                .table-cyber tr td:first-child {
                    border-top-left-radius: 16px;
                    border-bottom-left-radius: 16px;
                    border-left: 1px solid var(--card-border);
                }

                .table-cyber tr td:last-child {
                    border-top-right-radius: 16px;
                    border-bottom-right-radius: 16px;
                    border-right: 1px solid var(--card-border);
                }

            /* Modals iOS Glassmorphism */
            .modal-content-ios {
                background: rgba(13, 12, 29, 0.95) !important;
                backdrop-filter: blur(40px) saturate(200%) !important;
                -webkit-backdrop-filter: blur(40px) saturate(200%) !important;
                border: 1px solid rgba(255, 255, 255, 0.12) !important;
                border-radius: 28px !important;
                box-shadow: 0 25px 50px rgba(0, 0, 0, 0.7) !important;
                color: white;
            }

            .ios-input {
                background: rgba(255, 255, 255, 0.04) !important;
                border: 1px solid var(--card-border) !important;
                color: white !important;
                border-radius: 14px !important;
                padding: 12px 16px !important;
                font-size: 0.92rem !important;
                transition: all 0.25s ease !important;
            }

                .ios-input:focus {
                    background: rgba(255, 255, 255, 0.08) !important;
                    border-color: var(--accent-pink) !important;
                    box-shadow: 0 0 15px rgba(255, 42, 117, 0.25) !important;
                    outline: none !important;
                }

            .badge-count {
                background: rgba(255, 42, 117, 0.15);
                color: var(--accent-pink);
                border: 1px solid rgba(255, 42, 117, 0.3);
                border-radius: 30px;
                padding: 6px 16px;
                font-weight: 700;
                font-size: 0.8rem;
            }

            /* Background Option Cards */
            .bg-option-box {
                height: 70px;
                border-radius: 14px;
                border: 2px solid var(--card-border);
                cursor: pointer;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }

                .bg-option-box:hover {
                    transform: scale(1.03);
                    border-color: var(--accent-pink);
                }

                .bg-option-box.active {
                    border-color: var(--accent-pink);
                    box-shadow: 0 0 15px var(--accent-pink-glow);
                }
    </style>
</head>
<body class="bg-preset-1">

    <div class="app-container">

        <!-- ==================== SIDEBAR ==================== -->
        <aside class="sidebar">
            <div>
                <!-- Brand Logo -->
                <div class="brand-header">
                    <div class="brand-icon-box">
                        <i class="fa-solid fa-cake-candles"></i>
                    </div>
                    <div>
                        <div class="brand-title">SARA TORT</div>
                        <div class="brand-subtitle"><i class="fa-solid fa-shield-halved me-1"></i>Control System</div>
                    </div>
                </div>

                <!-- Main Navigation -->
                <div class="menu-section-title">ASOSIY MENYULAR</div>
                <nav class="nav-menu">
                    <a href="/Admin/Index" class="nav-item-link active">
                        <i class="fa-solid fa-chart-pie text-pink" style="width: 20px;"></i>
                        <span>Dashboard</span>
                    </a>

                    <a href="/Admin/Pechoniylar" class="nav-item-link">
                        <i class="fa-solid fa-cookie-bite text-warning" style="width: 20px;"></i>
                        <span>Pechoniylar Katalogi</span>
                    </a>

                    <!-- BAR DROPDOWN MENU -->
                    <div class="nav-item-dropdown">
                        <a href="javascript:void(0)" class="nav-item-link d-flex justify-content-between align-items-center" id="barMenuToggle" onclick="toggleBarMenu()">
                            <div class="d-flex align-items-center gap-3">
                                <i class="fa-solid fa-martini-glass-citrus text-info" style="width: 20px;"></i>
                                <span>Bar</span>
                            </div>
                            <i class="fa-solid fa-chevron-down text-secondary fs-6 transition-icon" id="barArrow"></i>
                        </a>

                        <!-- BAR SUB-MENU KATEGORIYALARI -->
                        <div class="sub-menu ps-4 ms-2 mt-1" id="barSubMenu" style="display: none; border-left: 1px dashed rgba(255,255,255,0.15);">
                            <a href="/Admin/Bar/Choylar" class="nav-item-link py-2 my-1" style="font-size: 0.85rem;">
                                <i class="fa-solid fa-mug-hot text-success me-1"></i> Choylar
                            </a>
                            <a href="/Admin/Bar/Kokteyllar" class="nav-item-link py-2 my-1" style="font-size: 0.85rem;">
                                <i class="fa-solid fa-glass-water-droplet text-primary me-1"></i> Kokteyllar
                            </a>
                            <a href="/Admin/Bar/Maxitolar" class="nav-item-link py-2 my-1" style="font-size: 0.85rem;">
                                <i class="fa-solid fa-wine-glass text-warning me-1"></i> Moxito
                            </a>
                            <a href="/Admin/Bar/Cofellar" class="nav-item-link py-2 my-1" style="font-size: 0.85rem;">
                                <i class="fa-solid fa-mug-saucer text-danger me-1"></i> Kofe
                            </a>
                        </div>
                    </div>
                </nav>

                <!-- Branch Phones Section -->
                <div class="menu-section-title mt-4">FILIALLAR TELEFONLARI</div>

                <div class="branch-info-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <small class="text-warning fw-bold" style="font-size: 11px;">Farg'ona filiali</small>
                        <button class="btn btn-link text-secondary p-0 m-0" data-bs-toggle="modal" data-bs-target="#editFerganaPhoneModal">
                            <i class="fa-solid fa-pen" style="font-size: 10px;"></i>
                        </button>
                    </div>
                    <div class="fw-bold text-white mt-1" style="font-size: 12px; letter-spacing: 0.5px;">+998 (95) 232-00-03</div>
                </div>

                <div class="branch-info-card">
                    <div class="d-flex align-items-center justify-content-between">
                        <small class="text-info fw-bold" style="font-size: 11px;">Marg'ilon filiali</small>
                        <button class="btn btn-link text-secondary p-0 m-0" data-bs-toggle="modal" data-bs-target="#editMargilanPhoneModal">
                            <i class="fa-solid fa-pen" style="font-size: 10px;"></i>
                        </button>
                    </div>
                    <div class="fw-bold text-white mt-1" style="font-size: 12px; letter-spacing: 0.5px;">+998 (95) 631-00-03</div>
                </div>
            </div>

            <!-- Profile Footer -->
            <div class="user-profile-box">
                <div class="d-flex align-items-center gap-3">
                    <div class="rounded-circle bg-dark p-2 text-white border border-secondary d-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
                        <i class="fa-solid fa-user-gear"></i>
                    </div>
                    <div>
                        <div class="fw-bold text-white" style="font-size: 13px;">Administrator</div>
                        <small class="text-success fw-semibold" style="font-size: 11px;">● Onlayn tizimda</small>
                    </div>
                </div>
            </div>
        </aside>

        <!-- ==================== MAIN CONTENT AREA ==================== -->
        <main class="main-wrapper">

            <!-- Top Bar / Header -->
            <div class="d-flex align-items-center justify-content-between mb-4 flex-wrap gap-3">
                <div>
                    <h3 class="header-title text-white mb-1">
                        <i class="fa-solid fa-wand-magic-sparkles text-pink me-2"></i>Boshqaruv Paneli
                    </h3>
                    <p class="text-secondary mb-0" style="font-size: 14px;">Tortlar va pechoniylar katalogini boshqarish hamda yangi mahsulotlar qo'shish</p>
                </div>

                <div class="d-flex align-items-center gap-3">
                    <!-- Live Search Input -->
                    <div class="cyber-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="searchInput" onkeyup="searchTable()" placeholder="Qidiruv...">
                    </div>

                    <!-- Change Background Button -->
                    <button class="btn btn-ios-secondary" data-bs-toggle="modal" data-bs-target="#changeBgModal" title="Orqa fonni o'zgartirish">
                        <i class="fa-solid fa-palette me-2 text-pink"></i>
                        <span>Orqa Fon</span>
                    </button>

                    <!-- Add Button -->
                    <button class="btn btn-ios-primary" data-bs-toggle="modal" data-bs-target="#addCakeModal">
                        <i class="fa-solid fa-plus-circle me-2"></i>
                        <span>Yangi Mahsulot</span>
                    </button>
                </div>
            </div>

            <!-- Statistics Cards Row -->
            <div class="row g-4 mb-4">
                <div class="col-md-6">
                    <div class="glass-card">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="text-secondary fw-bold" style="font-size: 11px; letter-spacing: 1.2px;">KATALOGDAGI MAHSULOTLAR</span>
                            <div class="p-3 rounded-4 bg-warning bg-opacity-10 text-warning">
                                <i class="fa-solid fa-cookie-bite fs-3"></i>
                            </div>
                        </div>
                        <h2 class="fw-extrabold text-white mb-1" style="font-size: 2.2rem;">@Model.KatalogdagiTortlarSoni xil</h2>
                        <small class="text-warning fw-bold"><i class="fa-solid fa-check-circle me-1"></i> Menyudagi faol mahsulotlar</small>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="glass-card">
                        <div class="d-flex align-items-center justify-content-between mb-3">
                            <span class="text-secondary fw-bold" style="font-size: 11px; letter-spacing: 1.2px;">FAOL MIJOZLAR</span>
                            <div class="p-3 rounded-4 bg-danger bg-opacity-10 text-pink">
                                <i class="fa-solid fa-heart-pulse fs-3"></i>
                            </div>
                        </div>
                        <h2 class="fw-extrabold text-white mb-1" style="font-size: 2.2rem;">@Model.FaolMijozlarSoni ta</h2>
                        <small class="text-secondary fw-bold"><i class="fa-solid fa-users me-1"></i> Jami ro'yxatdan o'tganlar</small>
                    </div>
                </div>
            </div>

            <!-- Products List Glass Table -->
            <div class="glass-card mb-4">
                <div class="d-flex align-items-center justify-content-between mb-4">
                    <div>
                        <h5 class="fw-bold text-white mb-1">
                            <i class="fa-solid fa-cake-candles text-pink me-2"></i>Katalogdagi Mahsulotlar
                        </h5>
                        <p class="text-secondary small mb-0">Bazaga kiritilgan barcha tortlar va pechoniylar ro'yxati</p>
                    </div>
                    <span class="badge-count">
                        Jami: @(Model.TortlarRoyxati?.Count ?? 0) ta
                    </span>
                </div>

                <div class="table-responsive table-cyber-container">
                    <table class="table table-cyber mb-0" id="productsTable">
                        <thead>
                            <tr>
                                <th style="width: 60px;" class="text-center">#</th>
                                <th style="width: 90px;">Rasm</th>
                                <th>Nomi</th>
                                <th>Tavsif</th>
                                <th>Narxi</th>
                                <th class="text-end" style="padding-right: 25px;">Amallar</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.TortlarRoyxati != null && Model.TortlarRoyxati.Any())
                            {
                                int index = 1;
                                @foreach (var cake in Model.TortlarRoyxati)
                                {
                                    <tr>
                                        <td class="text-center fw-bold text-secondary">@(index++)</td>
                                        <td>
                                            <img src="@cake.ImageUrl" alt="@cake.Title"
                                                 style="width: 52px; height: 52px; object-fit: cover; border-radius: 14px; border: 1px solid var(--card-border);"
                                                 onerror="this.onerror=null; this.src='/images/default-cake.png';" />
                                        </td>
                                        <td class="fw-bold text-white product-name">@cake.Title</td>
                                        <td class="text-secondary" style="max-width: 280px; font-size: 13px;">
                                            @(string.IsNullOrEmpty(cake.Description) ? "Tavsif kiritilmagan" : cake.Description)
                                        </td>
                                        <td class="fw-bold text-pink" style="font-size: 1rem;">
                                            @cake.Price.ToString("N0") <span style="font-size: 11px;">UZS</span>
                                        </td>
                                        <td class="text-end" style="padding-right: 20px;">
                                            <button class="btn btn-sm btn-outline-warning rounded-3 me-1 px-3 py-2"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#editCakeModal-@cake.Id"
                                                    title="Tahrirlash">
                                                <i class="fa-solid fa-pen"></i>
                                            </button>

                                            <button class="btn btn-sm btn-outline-danger rounded-3 px-3 py-2"
                                                    data-bs-toggle="modal"
                                                    data-bs-target="#deleteCakeModal-@cake.Id"
                                                    title="O'chirish">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        </td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="6" class="text-center text-muted py-5">
                                        <i class="fa-solid fa-box-open me-2 fs-3 mb-3 d-block text-secondary"></i>
                                        Hozircha mahsulotlar mavjud emas. Yuqoridagi tugma orqali yangisini qo'shing.
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

        </main>
    </div>

