@model SaraTort.Admin.Models.Login

@{
    Layout = null;
    ViewData["Title"] = "Tizimga Kirish - Sara Tort";
}

<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"]</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Google Fonts (Plus Jakarta Sans) -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            :root {
                --bg-dark: #080711;
                --accent-pink: #ff2a75;
                --accent-pink-glow: rgba(255, 42, 117, 0.4);
                --accent-purple: #8a2be2;
                --card-bg: rgba(20, 20, 42, 0.55);
                --card-border: rgba(255, 255, 255, 0.12);
                --text-primary: #ffffff;
                --text-secondary: #94a3b8;
            }

            * {
                box-sizing: border-box;
                margin: 0;
                padding: 0;
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: var(--bg-dark);
                color: var(--text-primary);
                min-height: 100vh;
                display: flex;
                align-items: center;
                justify-content: center;
                overflow: hidden;
                position: relative;
                background-image: radial-gradient(circle at 15% 20%, rgba(255, 42, 117, 0.18) 0%, transparent 45%), radial-gradient(circle at 85% 80%, rgba(138, 43, 226, 0.18) 0%, transparent 45%), linear-gradient(135deg, #080711 0%, #0f172a 100%);
            }

            /* Dynamic Animated Glow Orbs in Background */
            .glow-orb {
                position: absolute;
                border-radius: 50%;
                filter: blur(80px);
                z-index: 0;
                animation: float 8s infinite alternate ease-in-out;
            }

            .glow-orb-1 {
                width: 300px;
                height: 300px;
                background: rgba(255, 42, 117, 0.3);
                top: 10%;
                left: 20%;
            }

            .glow-orb-2 {
                width: 350px;
                height: 350px;
                background: rgba(138, 43, 226, 0.25);
                bottom: 10%;
                right: 20%;
                animation-delay: -4s;
            }

            /* Razor sintaksis xatoligini oldini olish uchun @@ float deb yoziladi */
            @@keyframes float {
                0% {
                    transform: translate(0, 0) scale(1);
                }

                100% {
                    transform: translate(30px, 40px) scale(1.1);
                }
            }

                100% {
                    transform: translate(30px, 40px) scale(1.1);
                }
            }

            /* Glassmorphism Card */
            .login-card {
                width: 100%;
                max-width: 440px;
                padding: 2.8rem 2.2rem;
                background: var(--card-bg);
                backdrop-filter: blur(35px) saturate(180%);
                -webkit-backdrop-filter: blur(35px) saturate(180%);
                border: 1px solid var(--card-border);
                border-radius: 28px;
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
                position: relative;
                z-index: 10;
                overflow: hidden;
            }

                .login-card::before {
                    content: '';
                    position: absolute;
                    top: 0;
                    left: 0;
                    right: 0;
                    height: 2px;
                    background: linear-gradient(90deg, transparent, var(--accent-pink), var(--accent-purple), transparent);
                }

            /* Brand Icon */
            .brand-box {
                width: 64px;
                height: 64px;
                background: linear-gradient(135deg, var(--accent-pink), var(--accent-purple));
                border-radius: 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 1.8rem;
                box-shadow: 0 10px 25px var(--accent-pink-glow);
                margin: 0 auto 1.2rem auto;
            }

            .brand-title {
                font-size: 1.5rem;
                font-weight: 800;
                letter-spacing: 0.5px;
                color: white;
            }

            .brand-subtitle {
                font-size: 0.82rem;
                color: var(--text-secondary);
            }

            /* Inputs */
            .input-group-cyber {
                position: relative;
                margin-bottom: 1.25rem;
            }

                .input-group-cyber i.input-icon {
                    position: absolute;
                    left: 16px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-secondary);
                    font-size: 1rem;
                    transition: all 0.25s ease;
                    z-index: 5;
                }

                .input-group-cyber .toggle-password {
                    position: absolute;
                    right: 16px;
                    top: 50%;
                    transform: translateY(-50%);
                    color: var(--text-secondary);
                    cursor: pointer;
                    z-index: 5;
                    transition: color 0.25s ease;
                }

                    .input-group-cyber .toggle-password:hover {
                        color: white;
                    }

            .cyber-input {
                width: 100%;
                background: rgba(255, 255, 255, 0.04);
                border: 1px solid var(--card-border);
                border-radius: 16px;
                padding: 14px 16px 14px 46px;
                color: white;
                font-size: 0.95rem;
                font-weight: 500;
                outline: none;
                transition: all 0.3s ease;
            }

                .cyber-input::placeholder {
                    color: rgba(255, 255, 255, 0.35);
                }

                .cyber-input:focus {
                    background: rgba(255, 255, 255, 0.08);
                    border-color: var(--accent-pink);
                    box-shadow: 0 0 20px rgba(255, 42, 117, 0.25);
                }

                    .cyber-input:focus ~ i.input-icon {
                        color: var(--accent-pink);
                    }

            /* Button */
            .btn-cyber-login {
                width: 100%;
                background: linear-gradient(135deg, var(--accent-pink), var(--accent-purple));
                border: 1px solid rgba(255, 255, 255, 0.2);
                color: white;
                font-weight: 700;
                font-size: 1rem;
                border-radius: 16px;
                padding: 14px;
                margin-top: 0.5rem;
                box-shadow: 0 10px 30px var(--accent-pink-glow);
                transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
                cursor: pointer;
                display: flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
            }

                .btn-cyber-login:hover {
                    transform: translateY(-2px) scale(1.01);
                    box-shadow: 0 14px 35px rgba(255, 42, 117, 0.6);
                    color: white;
                }

                .btn-cyber-login:active {
                    transform: translateY(0);
                }

            /* Checkbox */
            .custom-check {
                display: flex;
                align-items: center;
                gap: 8px;
                color: var(--text-secondary);
                font-size: 0.85rem;
                cursor: pointer;
                user-select: none;
            }

                .custom-check input {
                    accent-color: var(--accent-pink);
                    width: 16px;
                    height: 16px;
                    cursor: pointer;
                }

            /* Alert styling */
            .alert-cyber {
                background: rgba(239, 68, 68, 0.15);
                border: 1px solid rgba(239, 68, 68, 0.3);
                color: #f87171;
                border-radius: 14px;
                padding: 10px 14px;
                font-size: 0.85rem;
                margin-bottom: 1.25rem;
            }
    </style>
</head>
<body>

    <!-- Background Orbs -->
    <div class="glow-orb glow-orb-1"></div>
    <div class="glow-orb glow-orb-2"></div>

    <!-- Login Glass Card -->
    <div class="login-card">

        <!-- Header -->
        <div class="text-center mb-4">
            <div class="brand-box">
                <i class="fa-solid fa-cake-candles"></i>
            </div>
            <h4 class="brand-title">SARA TORT</h4>
            <p class="brand-subtitle">Boshqaruv paneliga kirish uchun ma'lumotlarni kiriting</p>
        </div>

        <!-- Validation Error Alert -->
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState[""]?.Errors.Count > 0)
        {
            <div class="alert-cyber d-flex align-items-center gap-2">
                <i class="fa-solid fa-circle-exclamation fs-5"></i>
                <div>
                    @foreach (var error in ViewData.ModelState[""]!.Errors)
                    {
                        <div>@error.ErrorMessage</div>
                    }
                </div>
            </div>
        }

        <!-- Login Form -->
        <form asp-action="Login" asp-controller="Admin" method="post">

            <!-- Username Input -->
            <div class="input-group-cyber">
                <i class="fa-solid fa-user input-icon"></i>
                <input type="text" asp-for="Username" class="cyber-input" placeholder="Login / Foydalanuvchi nomi" required autocomplete="off" />
            </div>

            <!-- Password Input -->
            <div class="input-group-cyber">
                <i class="fa-solid fa-lock input-icon"></i>
                <input type="password" asp-for="Password" id="passwordInput" class="cyber-input" placeholder="Parol" required />
                <i class="fa-solid fa-eye toggle-password" id="toggleIcon" onclick="togglePasswordVisibility()"></i>
            </div>

            <!-- Remember Me & Extra Link -->
            <div class="d-flex align-items-center justify-content-between mb-4 px-1">
                <label class="custom-check">
                    <input type="checkbox" asp-for="RememberMe" />
                    <span>Eslab qolinsin</span>
                </label>
                <a href="#" class="text-secondary text-decoration-none small hover-pink" style="font-size: 0.82rem;" onclick="alert('Parolni tiklash uchun tizim dasturchisiga murojaat qiling!')">Parolni unutdingizmi?</a>
            </div>

            <!-- Submit Button -->
            <button type="submit" class="btn-cyber-login">
                <span>Tizimga Kirish</span>
                <i class="fa-solid fa-arrow-right"></i>
            </button>
        </form>

        <div class="text-center mt-4">
            <small class="text-secondary" style="font-size: 0.75rem;">
                Sara Tort Control System v2.0 &copy; @DateTime.Now.Year
            </small>
        </div>

    </div>

    <!-- JavaScript -->
    <script>
            function togglePasswordVisibility() {
                const passwordInput = document.getElementById("passwordInput");
                const toggleIcon = document.getElementById("toggleIcon");

                if (passwordInput.type === "password") {
                    passwordInput.type = "text";
                    toggleIcon.classList.remove("fa-eye");
                    toggleIcon.classList.add("fa-eye-slash");
                } else {
                    passwordInput.type = "password";
                    toggleIcon.classList.remove("fa-eye-slash");
                    toggleIcon.classList.add("fa-eye");
                }
            }
    </script>
</body>
</html>