@model SaraTort.Admin.Models.DashboardViewModel

@{
    ViewData["Title"] = "Pechoniylar Katalogi";
}

<!-- Sarlavha paneli -->
<div class="d-flex align-items-center justify-content-between mb-4">
    <div>
        <h3 class="fw-extrabold text-white mb-1">
            <i class="fa-solid fa-cookie-bite text-warning me-2"></i>Pechoniylar Katalogi
        </h3>
        <p class="text-secondary mb-0">Pechoniy mahsulotlarini boshqarish va yangi tur qo'shish</p>
    </div>

    <button class="btn btn-ios-primary px-4 py-2" style="background: linear-gradient(135deg, #f59e0b, #d97706);">
        <i class="fa-solid fa-plus-circle me-1"></i> Yangi Pechoniy Qo'shish
    </button>
</div>

<!-- Faqat Pechoniylar Ro'yxati -->
<div class="glass-card">
    <div class="table-responsive">
        <table class="table table-dark table-hover mb-0 align-middle">
            <thead>
                <tr>
                    <th>#</th>
                    <th>Rasm</th>
                    <th>Nomi</th>
                    <th>Narxi</th>
                    <th class="text-end">Amallar</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.TortlarRoyxati != null && Model.TortlarRoyxati.Any())
                {
                    int index = 1;
                    @foreach (var item in Model.TortlarRoyxati)
                    {
                        <tr>
                            <td>@(index++)</td>
                            <td>
                                <img src="@item.ImageUrl" style="width: 45px; height: 45px; border-radius: 12px; object-fit: cover;" />
                            </td>
                            <td class="fw-bold">@item.Title</td>
                            <td class="text-warning fw-bold">@item.Price.ToString("N0") UZS</td>
                            <td class="text-end">
                                <button class="btn btn-sm btn-outline-warning me-1"><i class="fa-solid fa-pen"></i></button>
                                <button class="btn btn-sm btn-outline-danger"><i class="fa-solid fa-trash"></i></button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="5" class="text-center text-secondary py-4">
                            Hozircha pechoniylar katalogida mahsulot yo'q.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>