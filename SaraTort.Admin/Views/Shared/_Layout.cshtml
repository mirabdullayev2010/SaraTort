<!DOCTYPE html>
<html lang="uz">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sara Tort Admin</title>

    <!-- Bootstrap 5 CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- FontAwesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">

    <style>
            :root {
                --bg-dark: #0b0f19;
                --card-bg: rgba(22, 28, 45, 0.7);
                --border-color: rgba(255, 255, 255, 0.08);
                --accent-pink: #ff2a75;
                --accent-purple: #8a2be2;
                --text-muted: #94a3b8;
            }

            body {
                font-family: 'Plus Jakarta Sans', sans-serif;
                background-color: var(--bg-dark);
                color: #f8fafc;
                min-height: 100vh;
                margin: 0;
                overflow-x: hidden;
            }

            /* Sidebar Styling */
            .sidebar {
                width: 280px;
                height: 100vh;
                position: fixed;
                top: 0;
                left: 0;
                background: rgba(15, 23, 42, 0.95);
                backdrop-filter: blur(20px);
                border-right: 1px solid var(--border-color);
                display: flex;
                flex-direction: column;
                justify-content: space-between;
                padding: 1.5rem 1rem;
                z-index: 1000;
                overflow-y: auto;
            }

            .brand-logo {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0.5rem;
            }

            .brand-icon {
                width: 42px;
                height: 42px;
                background: linear-gradient(135deg, var(--accent-pink), var(--accent-purple));
                border-radius: 12px;
                display: flex;
                align-items: center;
                justify-content: center;
                color: white;
                font-size: 1.2rem;
                box-shadow: 0 4px 15px rgba(255, 42, 117, 0.4);
            }

            .nav-section-title {
                font-size: 0.7rem;
                font-weight: 800;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--text-muted);
                margin: 1.5rem 0 0.5rem 0.5rem;
            }

            .nav-link-custom {
                display: flex;
                align-items: center;
                gap: 12px;
                padding: 0.75rem 1rem;
                color: var(--text-muted);
                text-decoration: none;
                font-weight: 600;
                border-radius: 12px;
                transition: all 0.3s ease;
            }

                .nav-link-custom:hover {
                    color: white;
                    background: rgba(255, 255, 255, 0.05);
                }

                .nav-link-custom.active {
                    color: white;
                    background: linear-gradient(90deg, rgba(255, 42, 117, 0.2), rgba(138, 43, 226, 0.1));
                    border: 1px solid rgba(255, 42, 117, 0.3);
                }

            /* Main Content Wrapper */
            .main-content {
                margin-left: 280px;
                padding: 2rem;
                min-height: 100vh;
                width: calc(100% - 280px);
                box-sizing: border-box;
            }

            /* Glassmorphism Cards */
            .glass-card {
                background: var(--card-bg);
                backdrop-filter: blur(16px);
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 1.5rem;
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
            }

            /* Custom Buttons */
            .btn-ios-primary {
                background: linear-gradient(135deg, var(--accent-pink), var(--accent-purple));
                border: none;
                color: white;
                font-weight: 700;
                border-radius: 12px;
                box-shadow: 0 4px 15px rgba(255, 42, 117, 0.3);
                transition: all 0.3s ease;
                white-space: nowrap !important;
                display: inline-flex;
                align-items: center;
                justify-content: center;
            }

                .btn-ios-primary:hover {
                    transform: translateY(-2px);
                    box-shadow: 0 6px 20px rgba(255, 42, 117, 0.5);
                    color: white;
                }

            /* Table Styling */
            .table-dark {
                --bs-table-bg: transparent;
                --bs-table-border-color: var(--border-color);
            }

            .text-pink {
                color: var(--accent-pink);
            }
    </style>
</head>
<body>

    <!-- SIDEBAR -->
    <div class="sidebar">
        <div>
            <!-- Brand -->
            <div class="brand-logo mb-3">
                <div class="brand-icon">
                    <i class="fa-solid fa-cake-candles"></i>
                </div>
                <div>
                    <h6 class="fw-bold text-white mb-0" style="letter-spacing: 0.5px;">SARA TORT</h6>
                    <small class="text-pink font-bold" style="font-size: 10px;"><i class="fa-solid fa-shield-halved me-1"></i>Control System</small>
                </div>
            </div>

            <!-- Menus -->
            <div class="nav-section-title">ASOSIY MENYULAR</div>

            <a href="/Admin/Index" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Index" ? "active" : "")">
                <i class="fa-solid fa-chart-pie"></i>
                Dashboard
            </a>

            <a href="/Admin/Pechoniylar" class="nav-link-custom @(ViewContext.RouteData.Values["action"]?.ToString() == "Pechoniylar" ? "active" : "")">
                <i class="fa-solid fa-cookie-bite text-warning"></i>
                Pechoniylar Katalogi
            </a>

            <a href="#" class="nav-link-custom">
                <i class="fa-solid fa-users text-info"></i>
                Mijozlar Bazasi
            </a>

            <div class="nav-section-title">FILIALLAR TELEFONLARI</div>

            <!-- Filiallar mini bloki -->
            <div class="p-2 mb-2 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-warning fw-bold" style="font-size: 11px;">Farg'ona filiali</small>
                    <button class="btn btn-sm text-muted p-0 border-0" data-bs-toggle="modal" data-bs-target="#editFerganaPhoneModal">
                        <i class="fa-solid fa-pen" style="font-size: 10px;"></i>
                    </button>
                </div>
                <div class="fw-bold text-white mt-1" style="font-size: 12px;">+998 (95) 232-00-03</div>
            </div>

            <div class="p-2 mb-3 rounded-3" style="background: rgba(255, 255, 255, 0.03); border: 1px solid var(--border-color);">
                <div class="d-flex align-items-center justify-content-between">
                    <small class="text-info fw-bold" style="font-size: 11px;">Marg'ilon filiali</small>
                    <button class="btn btn-sm text-muted p-0 border-0" data-bs-toggle="modal" data-bs-target="#editMargilanPhoneModal">
                        <i class="fa-solid fa-pen" style="font-size: 10px;"></i>
                    </button>
                </div>
                <div class="fw-bold text-white mt-1" style="font-size: 12px;">+998 (95) 631-00-03</div>
            </div>
        </div>

        <!-- User Info Footer -->
        <div class="glass-card p-2 rounded-4">
            <div class="d-flex align-items-center gap-2">
                <div class="p-2 rounded-circle bg-dark text-white">
                    <i class="fa-solid fa-user-gear"></i>
                </div>
                <div>
                    <div class="fw-bold text-white" style="font-size: 13px;">Administrator</div>
                    <small class="text-success" style="font-size: 11px;">● Onlayn</small>
                </div>
            </div>
        </div>
    </div>

    <!-- MAIN CONTENT AREA -->
    <div class="main-content">
        @RenderBody()
    </div>

    <!-- Bootstrap 5 JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>