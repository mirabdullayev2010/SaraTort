@{
    ViewData["Title"] = "Bar va Ichimliklar";
}

<section class="mb-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
            <span class="text-xs font-bold text-purple-400 tracking-wider uppercase">SARA Cafe Bar</span>
            <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight mt-1">Mualliflik Ichimliklari</h2>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Drink Card Example -->
        <div class="ios-card-pro rounded-[2rem] p-5 flex flex-col justify-between group relative">
            <div class="absolute top-8 left-8 z-20 bg-black/40 backdrop-blur-md border border-white/10 px-3 py-1 rounded-full text-[10px] font-bold tracking-widest text-purple-300 uppercase">
                SALINUVCHAN
            </div>
            <div>
                <div class="relative h-60 rounded-2xl overflow-hidden mb-6 bg-gradient-to-b from-blue-900/30 to-black/60 border border-white/10 flex items-center justify-center">
                    <div class="w-24 h-24 rounded-3xl bg-gradient-to-tr from-cyan-500 to-purple-600 flex items-center justify-center font-black text-white text-xl shadow-2xl group-hover:scale-110 transition duration-500">
                        BAR
                    </div>
                    <div class="absolute bottom-4 right-4 bg-black/60 backdrop-blur-xl border border-white/15 px-4 py-1.5 rounded-xl font-extrabold text-white text-xs shadow-lg">
                        35 000 <span class="text-purple-400 text-[10px]">UZS</span>
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-purple-400 transition">Ice Cappuccino</h3>
                <p class="text-xs text-[#a1a1aa] leading-relaxed font-light mb-6">
                    Taza pishirilgan espresso, muzli sut va maxsus sirop qorishmasi.
                </p>
            </div>
            <button class="w-full bg-gradient-to-r from-purple-500/20 via-pink-500/20 to-purple-500/20 hover:from-purple-600 hover:to-pink-500 border border-purple-500/30 hover:border-transparent text-white py-3.5 rounded-xl font-bold text-xs tracking-wider uppercase transition duration-300 flex items-center justify-center gap-2">
                <span>Savatga qo'shish</span>
            </button>
        </div>
    </div>
</section>