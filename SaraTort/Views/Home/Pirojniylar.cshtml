@{
    ViewData["Title"] = "Pirojniylar";
}

<section class="mb-20">
    <div class="flex flex-col md:flex-row md:items-end justify-between mb-10 gap-4">
        <div>
            <span class="text-xs font-bold text-pink-400 tracking-wider uppercase">SARA Bakery</span>
            <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight mt-1">Nafis Pirojniylar</h2>
        </div>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8">
        <!-- Pirojniy Card Example -->
        <div class="ios-card-pro rounded-[2rem] p-5 flex flex-col justify-between group relative">
            <div class="absolute top-8 left-8 z-20 bg-black/40 backdrop-blur-md border border-white/10 px-3 py-1 rounded-full text-[10px] font-bold tracking-widest text-pink-300 uppercase">
                YANGI
            </div>
            <div>
                <div class="relative h-60 rounded-2xl overflow-hidden mb-6 bg-gradient-to-b from-purple-900/30 to-black/60 border border-white/10 flex items-center justify-center">
                    <div class="w-24 h-24 rounded-3xl bg-gradient-to-tr from-pink-500 to-rose-600 flex items-center justify-center font-black text-white text-xl shadow-2xl group-hover:scale-110 transition duration-500">
                        SARA
                    </div>
                    <div class="absolute bottom-4 right-4 bg-black/60 backdrop-blur-xl border border-white/15 px-4 py-1.5 rounded-xl font-extrabold text-white text-xs shadow-lg">
                        25 000 <span class="text-pink-400 text-[10px]">UZS</span>
                    </div>
                </div>
                <h3 class="text-2xl font-bold text-white mb-2 group-hover:text-pink-400 transition">Eklyer Pirojniy</h3>
                <p class="text-xs text-gray-400 leading-relaxed font-light mb-6">
                    Mayin krem va ustidan shokoladli glazur bilan qoplangan fransuzcha eklyer.
                </p>
            </div>
            <button onclick="toggleCart()" class="w-full bg-gradient-to-r from-pink-500/20 via-purple-500/20 to-pink-500/20 hover:from-pink-500 hover:to-purple-600 border border-pink-500/30 hover:border-transparent text-white py-3.5 rounded-xl font-bold text-xs tracking-wider uppercase transition duration-300 flex items-center justify-center gap-2">
                <span>Savatga qo'shish</span>
            </button>
        </div>
    </div>
</section>