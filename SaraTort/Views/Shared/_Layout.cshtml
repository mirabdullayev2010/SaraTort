<!DOCTYPE html>
<html lang="uz" class="scroll-smooth">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Sara Tort</title>

    <!-- Tailwind CSS CDN -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Lucide Icons -->
    <script src="https://unpkg.com/lucide@latest"></script>

    <style>
            body {
                background: #09040e;
                color: #f3f4f6;
                font-family: -apple-system, BlinkMacSystemFont, "SF Pro Display", "Segoe UI", Roboto, sans-serif;
                overflow-x: hidden;
            }

            /* Ambient Glowing Background Animations */
            .ambient-glow-1 {
                position: fixed;
                top: -10%;
                left: -10%;
                width: 50vw;
                height: 50vw;
                background: radial-gradient(circle, rgba(236, 72, 153, 0.25) 0%, rgba(0,0,0,0) 70%);
                filter: blur(80px);
                z-index: -1;
                animation: pulseGlow 8s infinite alternate ease-in-out;
            }

            .ambient-glow-2 {
                position: fixed;
                bottom: -10%;
                right: -10%;
                width: 60vw;
                height: 60vw;
                background: radial-gradient(circle, rgba(147, 51, 234, 0.2) 0%, rgba(0,0,0,0) 70%);
                filter: blur(100px);
                z-index: -1;
                animation: pulseGlow 12s infinite alternate ease-in-out;
            }

            @@keyframes pulseGlow {
                0% {
                    transform: scale(1) translate(0, 0);
                }

                100% {
                    transform: scale(1.2) translate(30px, -20px);
                }
            }

            /* Ultra Liquid Glassmorphism */
            .ios-glass-nav {
                background: rgba(18, 10, 26, 0.45);
                backdrop-filter: blur(25px) saturate(200%);
                -webkit-backdrop-filter: blur(25px) saturate(200%);
                border: 1px solid rgba(255, 255, 255, 0.12);
                box-shadow: 0 20px 50px rgba(0, 0, 0, 0.5), inset 0 1px 0 rgba(255, 255, 255, 0.15);
            }

            .ios-card-pro {
                background: linear-gradient(135deg, rgba(255, 255, 255, 0.05) 0%, rgba(255, 255, 255, 0.01) 100%);
                backdrop-filter: blur(30px);
                -webkit-backdrop-filter: blur(30px);
                border: 1px solid rgba(255, 255, 255, 0.08);
                box-shadow: 0 10px 30px rgba(0, 0, 0, 0.3);
                transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            }

                .ios-card-pro:hover {
                    border-color: rgba(236, 72, 153, 0.5);
                    box-shadow: 0 20px 40px rgba(236, 72, 153, 0.25), inset 0 0 15px rgba(236, 72, 153, 0.1);
                }

            /* Neon Shimmer Text */
            .shimmer-text {
                background: linear-gradient(90deg, #fff 0%, #ec4899 50%, #fff 100%);
                background-size: 200% auto;
                color: transparent;
                -webkit-background-clip: text;
                animation: shine 4s linear infinite;
            }

            @@keyframes shine {
                to {
                    background-position: 200% center;
                }
            }
    </style>
</head>
<body class="min-h-screen flex flex-col justify-between selection:bg-pink-500 selection:text-white">
    <!-- Glowing Orbs -->
    <div class="ambient-glow-1"></div>
    <div class="ambient-glow-2"></div>

    <!-- Floating Dynamic Island Header -->
    <header class="sticky top-5 z-50 max-w-5xl mx-auto px-4 w-full">
        <nav class="ios-glass-nav rounded-full px-6 py-2.5 flex items-center justify-between">
            <!-- Logotip -->
            <a class="flex items-center gap-3 group" asp-controller="Home" asp-action="Index">
                <div class="w-10 h-10 rounded-xl overflow-hidden shadow-md shadow-pink-500/20 border border-white/20 group-hover:scale-105 transition-transform duration-300 flex items-center justify-center bg-black/30">
                    <img src="~/images/logo.png" onerror="this.onerror=null; this.src='https://i.postimg.cc/mD8p95k1/logo.png';" alt="SARA cafe & bakery" class="w-full h-full object-cover" />
                </div>
                <span class="font-black text-xl tracking-tight shimmer-text">
                    SARA TORT
                </span>
            </a>

            <!-- Navigation Links -->
            @{
                var currentAction = ViewContext.RouteData.Values["Action"]?.ToString();
            }
            <div class="hidden md:flex items-center gap-1 bg-black/40 p-1.5 rounded-full border border-white/10 backdrop-blur-md">
                <a asp-controller="Home" asp-action="Index"
                   class="px-5 py-2 rounded-full text-xs font-bold transition duration-300 @(currentAction == "Index" ? "text-white bg-white/20 shadow-inner border border-white/10" : "text-gray-400 hover:text-white hover:bg-white/5")">
                    Tortlar
                </a>
                <a asp-controller="Home" asp-action="Pirojniylar"
                   class="px-5 py-2 rounded-full text-xs font-bold transition duration-300 @(currentAction == "Pirojniylar" ? "text-white bg-white/20 shadow-inner border border-white/10" : "text-gray-400 hover:text-white hover:bg-white/5")">
                    Pirojniylar
                </a>
                <a asp-controller="Home" asp-action="Bar"
                   class="px-5 py-2 rounded-full text-xs font-bold transition duration-300 @(currentAction == "Bar" ? "text-white bg-white/20 shadow-inner border border-white/10" : "text-gray-400 hover:text-white hover:bg-white/5")">
                    Bar
                </a>
            </div>

            <!-- Savat Button -->
            <button onclick="toggleCart()" class="relative group bg-gradient-to-r from-pink-500 to-purple-600 text-white px-5 py-2.5 rounded-full text-xs font-bold shadow-lg shadow-pink-500/30 hover:scale-105 active:scale-95 transition flex items-center gap-2 overflow-hidden">
                <span class="absolute inset-0 bg-white/20 opacity-0 group-hover:opacity-100 transition"></span>
                <i data-lucide="shopping-bag" class="w-4 h-4"></i>
                <span>Savat</span>
                <span id="cart-badge" class="bg-white text-purple-950 font-black text-[10px] px-2 py-0.5 rounded-full shadow">1</span>
            </button>
        </nav>
    </header>

    <!-- Main Content -->
    <main role="main" class="max-w-6xl mx-auto px-4 mt-8 w-full flex-grow">
        @RenderBody()

        <!-- Yagona Filiallar va Ijtimoiy tarmoqlar Sektsiyasi -->
        <section id="filiallar" class="mt-24 mb-8">
            <div class="mb-8">
                <span class="text-[11px] font-bold text-pink-400 tracking-widest uppercase block mb-1">
                    ALOQA VA LOKATSIYA
                </span>
                <h2 class="text-3xl md:text-4xl font-black text-white tracking-tight">
                    Bizning Filiallar
                </h2>
            </div>

            <!-- 2 ta Filial kartasi -->
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-8">
                <div class="ios-card-pro rounded-3xl p-6 flex items-center justify-between group">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-pink-500/10 border border-pink-500/20 flex items-center justify-center text-pink-400 group-hover:scale-110 transition duration-300">
                            <i data-lucide="map-pin" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <span class="text-[10px] font-black text-pink-400 tracking-wider uppercase block">MARKAZIY</span>
                            <h3 class="text-xl font-bold text-white tracking-wide">Farg'ona filiali</h3>
                            <p class="text-xs text-gray-400 font-mono mt-1">+998 (95) 232-00-03</p>
                        </div>
                    </div>
                    <a href="tel:+998952320003" class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-gray-300 hover:text-white hover:bg-pink-500/20 hover:border-pink-500/30 transition duration-300">
                        <i data-lucide="phone-call" class="w-5 h-5"></i>
                    </a>
                </div>

                <div class="ios-card-pro rounded-3xl p-6 flex items-center justify-between group">
                    <div class="flex items-center gap-4">
                        <div class="w-14 h-14 rounded-2xl bg-purple-500/10 border border-purple-500/20 flex items-center justify-center text-purple-400 group-hover:scale-110 transition duration-300">
                            <i data-lucide="map-pin" class="w-6 h-6"></i>
                        </div>
                        <div>
                            <span class="text-[10px] font-black text-purple-400 tracking-wider uppercase block">FILIAL</span>
                            <h3 class="text-xl font-bold text-white tracking-wide">Marg'ilon filiali</h3>
                            <p class="text-xs text-gray-400 font-mono mt-1">+998 (95) 631-00-03</p>
                        </div>
                    </div>
                    <a href="tel:+998956310003" class="w-12 h-12 rounded-2xl bg-white/5 border border-white/10 flex items-center justify-center text-gray-300 hover:text-white hover:bg-purple-500/20 hover:border-purple-500/30 transition duration-300">
                        <i data-lucide="phone-call" class="w-5 h-5"></i>
                    </a>
                </div>
            </div>

            <!-- Telegram & Instagram Tugmalari -->
            <div class="flex items-center justify-center gap-4 pt-2">
                <a href="https://t.me/saratort_fergana" target="_blank" rel="noopener noreferrer"
                   class="ios-card-pro px-5 py-2.5 rounded-full flex items-center gap-2 text-xs font-semibold text-gray-300 hover:text-white hover:border-sky-500/50 hover:bg-sky-500/10 transition-all duration-300">
                    <svg class="w-4 h-4 text-sky-400 fill-current" viewBox="0 0 24 24">
                        <path d="M12 0C5.37 0 0 5.37 0 12s5.37 12 12 12 12-5.37 12-12S18.63 0 12 0zm5.56 8.16l-2.02 9.52c-.15.68-.55.85-1.12.53l-3.08-2.27-1.49 1.43c-.16.16-.3.3-.62.3l.22-3.13 5.7-5.15c.25-.22-.05-.34-.38-.12l-7.05 4.44-3.04-.95c-.66-.21-.67-.66.14-.98l11.89-4.58c.55-.2 1.03.13.85.96z" />
                    </svg>
                    <span>Telegram</span>
                </a>

                <a href="https://www.instagram.com/saratort_fergana/" target="_blank" rel="noopener noreferrer"
                   class="ios-card-pro px-5 py-2.5 rounded-full flex items-center gap-2 text-xs font-semibold text-gray-300 hover:text-white hover:border-pink-500/50 hover:bg-pink-500/10 transition-all duration-300">
                    <svg class="w-4 h-4 text-pink-400 stroke-current" fill="none" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24">
                        <rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect>
                        <path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path>
                        <line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line>
                    </svg>
                    <span>Instagram</span>
                </a>
            </div>
        </section>
    </main>

    <!-- Glass Footer -->
    <footer class="mt-16 border-t border-white/10 py-8 backdrop-blur-lg bg-black/30">
        <div class="max-w-6xl mx-auto px-4 flex flex-col md:flex-row justify-between items-center gap-4 text-xs text-gray-400">
            <div class="flex items-center gap-2">
                <div class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></div>
                &copy; 2026 <span class="font-bold text-gray-200">SaraTort</span> Control System. Barcha huquqlar himoyalangan.
            </div>
            <div class="flex gap-6 font-medium">
                <a href="#filiallar" class="hover:text-pink-400 transition">Filiallar</a>
                <a asp-controller="Home" asp-action="Privacy" class="hover:text-pink-400 transition">Maxfiylik siyosati</a>
            </div>
        </div>
    </footer>

    <!-- Lucide Icons & Script Initialize -->
    <script>
            lucide.createIcons();
    </script>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>